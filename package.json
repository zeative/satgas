{
  "name": "satgas",
  "version": "0.1.15",
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "description": "Self-hosted workspace where AI coding agents work as a team on a shared canvas.",
  "engines": {
    "bun": ">=1.2.0"
  },
  "keywords": [
    "agents",
    "orchestration",
    "claude-code",
    "codex",
    "ai",
    "canvas",
    "bun"
  ],
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun --hot src/server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "bun scripts/build.ts",
    "start": "vite build && NODE_ENV=production bun src/server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "type": "module",
  "dependencies": {
    "@dicebear/core": "^9.4.2",
    "@dicebear/notionists": "^9.4.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@pierre/diffs": "1.6.4",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-router": "^1.170.46",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "emojibase-data": "^18.0.0",
    "frimousse": "^0.4.0",
    "html-to-image": "1.11.11",
    "lucide-react": "^1.66.0",
    "perfect-freehand": "^1.2.3",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roughjs": "^4.6.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zaileys": "^4.18.0",
    "zustand": "^5.0.16"
  }
}
