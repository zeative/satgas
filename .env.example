# Only needed on a server. Leave both empty to run on your own computer.

# The public HTTPS address of your reverse proxy.
SATGAS_PUBLIC_URL=https://satgas.example.com

# A long random sign-in token, e.g. the output of: openssl rand -base64 32
SATGAS_TOKEN=

# How much memory the container may use (default 8g). Each running app build needs about 2 GB.
# SATGAS_MEMORY_LIMIT=8g
